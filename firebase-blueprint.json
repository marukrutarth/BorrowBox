  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profiles containing non-PII display attributes and dual renter/owner flags."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Isolated private user profile data (email, phone) accessible only to the profile owner or administrators."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Dedicated RBAC administrator registry kept strictly separate from standard user profiles."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "User-published peer-to-peer rental listings."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/RentalBooking" },
      "description": "Auditable rental bookings between borrowers and owners."
    },
    "/bookings/{bookingId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/BookingMessage" },
      "description": "Private handover coordination messages between the booking borrower and owner."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/RentalReview" },
      "description": "Verified reviews linked strictly to completed rental bookings."
    },
    "/user_moderation/{userId}": {
      "schema": { "$ref": "#/entities/UserModeration" },
      "description": "Administrative user suspension and moderation records."
    },
    "/listing_moderation/{listingId}": {
      "schema": { "$ref": "#/entities/ListingModeration" },
      "description": "Administrative listing approval, rejection, and flag status records."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/PlatformReport" },
      "description": "Reported listings, users, and booking complaints."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Legacy customer support tickets collection."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicketV2" },
      "description": "Primary BorrowBox support tickets collection with claiming, priority, and resolution tracking."
    },
    "/supportTickets/{ticketId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportTicketMessage" },
      "description": "Conversation messages and internal notes for a support ticket."
    },
    "/supportTickets/{ticketId}/history/{eventId}": {
      "schema": { "$ref": "#/entities/SupportTicketHistory" },
      "description": "Audit history of events on a support ticket."
    },
    "/supportNotifications/{notifId}": {
      "schema": { "$ref": "#/entities/SupportNotification" },
      "description": "In-app notifications for customers and support staff."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable append-only administrative activity logs."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configuration settings."
    }
  }
}
