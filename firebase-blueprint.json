{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible marketplace profile for a BorrowBox user who can act as both renter and owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth user ID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user.",
          "minLength": 2,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL or generated initials URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "description": "Primary Indian city or town across all 28 states and 8 union territories for rentals and listings.",
          "minLength": 2,
          "maxLength": 60
        },
        "neighborhood": {
          "type": "string",
          "description": "Locality or neighborhood within the city.",
          "minLength": 2,
          "maxLength": 80
        },
        "canRent": {
          "type": "boolean",
          "description": "Indicates the user can borrow/rent items on BorrowBox."
        },
        "canList": {
          "type": "boolean",
          "description": "Indicates the user can list/own items for rent on BorrowBox."
        },
        "activeMode": {
          "type": "string",
          "description": "Current workspace perspective selected by the user.",
          "enum": ["renter", "owner"],
          "minLength": 5,
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable account creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp."
        }
      },
      "required": [
        "uid",
        "name",
        "photoURL",
        "city",
        "neighborhood",
        "canRent",
        "canList",
        "activeMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Strictly isolated PII document containing email, phone number, and private identity verification metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Auth user ID matching parent userId.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Private email address of the user.",
          "minLength": 5,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Private Indian mobile phone number.",
          "minLength": 0,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable record creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last private record update timestamp."
        }
      },
      "required": ["uid", "email", "phone", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Role-based administrator registry document keyed by lowercase Gmail or UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "uid": {
          "type": "string",
          "description": "Admin user UID or pending invite identifier.",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator Gmail address.",
          "minLength": 5,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "moderator", "support_admin"],
          "minLength": 5,
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["active", "deactivated"],
          "minLength": 6,
          "maxLength": 15
        },
        "customPermissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "revokedPermissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "grantedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "email",
        "name",
        "role",
        "status",
        "customPermissions",
        "revokedPermissions",
        "grantedBy",
        "grantedAt",
        "lastLoginAt",
        "updatedAt"
      ]
    },
    "MarketplaceListing": {
      "title": "MarketplaceListing",
      "description": "User-created peer-to-peer rental listing with pricing in INR, deposit, availability window, and status.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Electronics",
            "Photography",
            "Gaming",
            "Tools",
            "Events",
            "Outdoor",
            "Education",
            "Musical Instruments"
          ],
          "minLength": 4,
          "maxLength": 30
        },
        "condition": {
          "type": "string",
          "enum": ["Like New", "Excellent", "Good"],
          "minLength": 4,
          "maxLength": 15
        },
        "dailyPriceINR": {
          "type": "integer",
          "description": "Daily rental rate in Indian Rupees."
        },
        "refundableDepositINR": {
          "type": "integer",
          "description": "Refundable security deposit in Indian Rupees."
        },
        "replacementValueINR": {
          "type": "integer",
          "description": "Approximate retail replacement price in Indian Rupees."
        },
        "city": {
          "type": "string",
          "description": "Recognised Indian city or town across all 28 states and 8 union territories.",
          "minLength": 2,
          "maxLength": 60
        },
        "neighborhood": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "pickupLocation": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000
        },
        "availableFrom": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "availableTo": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "minRentalDays": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "minLength": 6,
          "maxLength": 10
        },
        "cancellationPolicy": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "title",
        "category",
        "condition",
        "dailyPriceINR",
        "refundableDepositINR",
        "replacementValueINR",
        "city",
        "neighborhood",
        "pickupLocation",
        "description",
        "imageUrl",
        "availableFrom",
        "availableTo",
        "minRentalDays",
        "status",
        "cancellationPolicy",
        "createdAt",
        "updatedAt"
      ]
    },
    "RentalBooking": {
